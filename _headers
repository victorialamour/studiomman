# Regras de cache para o Cloudflare Pages.
# A ideia é simples: o HTML pode mudar a qualquer momento, então ele nunca
# fica guardado; o vídeo e as imagens têm nome fixo e quase nunca mudam,
# então ficam guardados por um ano no navegador de quem já visitou.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
